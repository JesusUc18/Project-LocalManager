@model Producto
@{
    ViewData["Title"] = "Detalle del Producto";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-eye me-2"></i>Detalle del Producto</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">#@Model.Id</dd>
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Model.Descripcion</dd>
                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark">@Model.CategoriaNombre</span></dd>
                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8">$@Model.Precio.ToString("N2")</dd>
                    <dt class="col-sm-4">Stock</dt>
                    <dd class="col-sm-8">
                        @if (Model.Stock < 5)
                        {
                            <span class="badge bg-danger">@Model.Stock - Stock bajo</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Stock</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Código de Barras</dt>
                    <dd class="col-sm-8">@Model.CodigoBarras</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
                <a href="/Productos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
            </div>
        </div>
    </div>
</div>
