@model Caja
@{
    ViewData["Title"] = "Cerrar Caja";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark"><i class="bi bi-lock me-2"></i>Cerrar Caja #@Model.Id</div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>Monto Inicial:</strong> $@Model.MontoInicial.ToString("N2")<br>
                    <strong>Total Ventas:</strong> $@Model.TotalVentas.ToString("N2")<br>
                    <strong>Esperado:</strong> $@((Model.MontoInicial + Model.TotalVentas).ToString("N2"))
                </div>
                <form asp-action="Cerrar" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="montoCierre" class="form-label">Monto de Cierre</label>
                        <input type="number" step="0.01" name="montoCierre" id="montoCierre" class="form-control" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-lock me-1"></i>Cerrar Caja</button>
                        <a href="/Caja" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
