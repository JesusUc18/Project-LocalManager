@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2"></i>Clientes</span>
        <a href="/Clientes/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nuevo Cliente</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Nombre</th><th>Teléfono</th><th>Email</th><th>Fecha Registro</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Telefono</td>
                            <td>@item.Email</td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a href="/Clientes/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <a href="/Clientes/Delete/@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No hay clientes registrados.</p>
                <a href="/Clientes/Create" class="btn btn-primary btn-sm">Agregar el primero</a>
            </div>
        }
    </div>
</div>
