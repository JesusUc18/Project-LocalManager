@model LocalManager.Presentation.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
    <h2 class="mt-3">Ocurrió un error</h2>
    <p class="text-muted">Lo sentimos, algo salió mal. Por favor intenta de nuevo.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary mt-3"><i class="bi bi-arrow-left"></i> Volver al inicio</a>
</div>
