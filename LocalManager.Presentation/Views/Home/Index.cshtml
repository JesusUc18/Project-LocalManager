@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div><p class="text-muted mb-1 small text-uppercase">Productos</p><h3 class="mb-0">@ViewBag.TotalProductos</h3></div>
                    <div class="bg-primary bg-opacity-10 rounded p-2"><i class="bi bi-box-seam text-primary fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div><p class="text-muted mb-1 small text-uppercase">Stock Bajo</p><h3 class="mb-0 text-danger">@ViewBag.ProductosBajosStock</h3></div>
                    <div class="bg-danger bg-opacity-10 rounded p-2"><i class="bi bi-exclamation-triangle text-danger fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div><p class="text-muted mb-1 small text-uppercase">Ventas Hoy</p><h3 class="mb-0">@ViewBag.VentasHoy</h3></div>
                    <div class="bg-success bg-opacity-10 rounded p-2"><i class="bi bi-cart-check text-success fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card info h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div><p class="text-muted mb-1 small text-uppercase">Total Hoy</p><h3 class="mb-0">$@ViewBag.TotalVentasHoy.ToString("N2")</h3></div>
                    <div class="bg-info bg-opacity-10 rounded p-2"><i class="bi bi-currency-dollar text-info fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-lightning-charge me-2"></i>Acciones Rápidas</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a href="/Ventas/Create" class="card text-decoration-none text-center p-4" style="border: 2px dashed #3498db; background: #f8fbff;">
                            <i class="bi bi-cart-plus fs-1 text-primary mb-2"></i><h6 class="text-primary mb-0">Nueva Venta</h6>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Productos/Create" class="card text-decoration-none text-center p-4" style="border: 2px dashed #27ae60; background: #f8fff8;">
                            <i class="bi bi-plus-circle fs-1 text-success mb-2"></i><h6 class="text-success mb-0">Agregar Producto</h6>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Caja/Abrir" class="card text-decoration-none text-center p-4" style="border: 2px dashed #9b59b6; background: #faf8ff;">
                            <i class="bi bi-cash-coin fs-1 text-info mb-2"></i><h6 class="text-info mb-0">Abrir Caja</h6>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Estado del Sistema</div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <span class="text-muted">Cajas Abiertas</span><span class="badge bg-success">@ViewBag.CajasAbiertas</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <span class="text-muted">Base de Datos</span><span class="badge bg-secondary">JSON (Temporal)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Arquitectura</span><span class="badge bg-light text-dark">Clean Architecture (ADR-03)</span>
                </div>
            </div>
        </div>
    </div>
</div>
