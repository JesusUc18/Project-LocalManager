@model IEnumerable<LocalManager.Domain.Entities.Caja>
@{
    ViewData["Title"] = "Caja";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-cash-stack me-2"></i>Control de Cajas</span>
        <a href="/Caja/Abrir" class="btn btn-success btn-sm"><i class="bi bi-plus-lg me-1"></i>Abrir Caja</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Caja #</th><th>Apertura</th><th>Cierre</th><th>Monto Inicial</th><th>Total Ventas</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@item.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td>$@item.MontoInicial.ToString("N2")</td>
                            <td>$@item.TotalVentas.ToString("N2")</td>
                            <td>
                                @if (item.Estado == "Abierta")
                                {<span class="badge bg-success">Abierta</span>}
                                else
                                {<span class="badge bg-secondary">Cerrada</span>}
                            </td>
                            <td class="text-end">
                                <a href="/Caja/Details/@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                @if (item.Estado == "Abierta")
                                {<a href="/Caja/Cerrar/@item.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-lock"></i></a>}
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No hay cajas registradas.</p>
                <a href="/Caja/Abrir" class="btn btn-success btn-sm">Abrir la primera caja</a>
            </div>
        }
    </div>
</div>
