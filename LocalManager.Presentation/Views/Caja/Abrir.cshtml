@model LocalManager.Domain.Entities.Caja
@{
    ViewData["Title"] = "Abrir Caja";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-success">
            <div class="card-header bg-success text-white"><i class="bi bi-unlock me-2"></i>Abrir Nueva Caja</div>
            <div class="card-body">
                <form asp-action="Abrir" method="post">
                    <div class="mb-3">
                        <label asp-for="MontoInicial" class="form-label"></label>
                        <input asp-for="MontoInicial" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Responsable" class="form-label"></label>
                        <input asp-for="Responsable" class="form-control" placeholder="Nombre del encargado" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success"><i class="bi bi-unlock me-1"></i>Abrir Caja</button>
                        <a href="/Caja" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
